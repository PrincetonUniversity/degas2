\ID{$Id$}

Declarations of the string routines.

@f st_decls integer
@m st_decls
      external string_length,read_string,parse_string,next_token,string_lookup,int_lookup,read_real,read_integer,read_int_soft_fail,read_real_soft_fail;
      integer string_length,parse_string,string_lookup,int_lookup,read_integer,read_int_soft_fail;
      real read_real,read_real_soft_fail;
      logical read_string,next_token @;

@ A string without its trailing blanks

@m SP $UNQUOTE(' ')
@m trim(s) s SP (1:string_length(s))

@ Read text from a string (does nothing)
@m read_text(x) x
