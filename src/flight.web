@m FILE 'flight.web'

@m MANDREKAS 0
@m EIR_REC_BENCH 0
@m WMIN_PMI const(1.,4)

@I macros.hweb
@I zone.hweb
@I sysdep.hweb
@I particle.hweb
@I flight.hweb
@I random.hweb
@I background.hweb
@I species.hweb
@I string.hweb
@I problem.hweb
@I location.hweb
@I reaction.hweb
@I sector.hweb
@I pmiformat.hweb
@I pmidata.hweb
@I sources.hweb
@I tally.hweb
@I output.hweb
