@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'geomtesta.web'
@I macros.hweb
@I string.hweb
@I geomint.hweb
@I zone.hweb
@I background.hweb
@I problem.hweb
@I species.hweb
@I detector.hweb
@I tally.hweb
@I output.hweb
@I netcdf.hweb
@I sysdep.hweb
@I readfilenames.hweb
@I reaction.hweb
@I materials.hweb

@m CMOD 0    // Enable calls to |integral_region|, specific to C-Mod

@ The main program.

@a
      program geometry_test
      implicit_none_f77
      implicit_none_f90

      call readfilenames
@#if 0
      call read_geometry
      call nc_read_species
      call nc_read_reactions
