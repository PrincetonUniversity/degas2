@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'geomtesta.web'
@I macros.hweb
@I string.hweb
@I geomint.hweb
@I zone.hweb
@I background.hweb
@I problem.hweb
@I detector.hweb
@I species.hweb
@I tally.hweb
@I output.hweb
@I netcdf.hweb
@I sysdep.hweb
@I readfilenames.hweb
@I reaction.hweb
@I materials.hweb

@m CMOD 1    // Enable calls to |integral_region|, specific to C-Mod

@ The main program.

@a
      program geometry_test
      implicit_none_f77
      implicit_none_f90

      call readfilenames
      call read_geometry
      call nc_read_species
      call nc_read_reactions
      call nc_read_materials
      call nc_read_pmi
      call nc_read_problem
      call nc_read_background
      call read_cramd_data

      call nc_read_tally
      call nc_read_output

      call exercise

      stop
      end

      @<Functions and Subroutines@>

@ Exercise the locate function

@<Functions...@>=
      subroutine exercise

      define_varp(hdf_data,FLOAT,zone_ind)

      implicit_none_f77
      sp_common
      tl_common
      ou_common
      bk_common
      zn_common
      pr_common
      de_common
      implicit_none_f90
      real x[3],a[3],b[3],alen,blen,ha_rate,halpha_tot,  // Local
     $     ha_temp,density,pressure
      real integrals[4]
      integer i,j,k,zone,test,back,iview
      integer index_parameters[tl_index_max]
      external zone_func,density_func,te_func,ti_func
      integer zone_func,density_func,te_func,ti_func
      external extract_output_datum,integral_region
      real extract_output_datum
      integer integral_region
      character*4 ivlab

      declare_varp(hdf_data)
      
      @<Memory allocation interface@>
      st_decls
      tl_decls
      
      open(unit=diskin,file='geometry.inp',status='old',form='formatted')
      read(diskin,*) SP (x[i],i=1,3),(a[i],i=1,3),(b[i],i=1,3),alen,blen
      close(unit=diskin)

      open(unit=diskout,file='integrals.out',status='unknown')
      
/* to plot just the geometry keep only this call to output_slice */
      call output_slice('geomtesta.hdf',.true.,x,a,b,alen,blen,zone_func)
//      call output_slice('geomtesta.hdf',.false.,x,a,b,alen,blen,density_func)
//      call output_slice('geomtesta.hdf',.false.,x,a,b,alen,blen,te_func)
//      call output_slice('geomtesta.hdf',.false.,x,a,b,alen,blen,ti_func)

      var_alloc(hdf_data)

@#if 1
      do i=1,zn_num
         if (zn_type(i) == zn_plasma) then
            hdf_data[i]=bk_n(1,i)                  // BACKGROUND DENSITY
         else
            hdf_data[i]=zero
         end if
      end do
      call data_slice('bk_n1.hdf',hdf_data,'electron density','m**-3','E11.3',
     $     x,a,b,alen,blen)

      do i=1,zn_num
         if (zn_type(i) == zn_plasma) then         // BACKGROUND TEMPERATURE
            hdf_data[i]=bk_temp(1,i)/electron_charge
         else
            hdf_data[i]=zero
         end if
      end do
      call data_slice('bk_t1.hdf',hdf_data,'electron temperature','eV','E11.3',
     $     x,a,b,alen,blen)

@#endif
      do j=1,3
         if (j==1) then
            iview=1
            ivlab='1'
         else if (j==2) then
            iview=35
            ivlab='35'
         else 
            iview=36
            ivlab='spec'
         end if
         do i=1,zn_num
            if (zn_type(i) == zn_plasma || zn_type(i) == zn_vacuum) then
               hdf_data[i]=de_zone_frags[i][iview]
            else
               hdf_data[i]=zero
            end if
         end do
         call data_slice('zn_frag_'\/trim(ivlab)\/'.hdf',hdf_data,
     $        'zone frag view '\/trim(ivlab),' ','E11.3',x,a,b,alen,blen)
      end do
@#if 1
      do j=2,pr_test_num
         index_parameters[tl_index_test]=j
         ha_temp=zero
         do k=1,4
            integrals[k]=zero
         end do
         do i=1,zn_num
            if (zn_type(i) == zn_plasma) then
               index_parameters[tl_index_zone]=i
               density=extract_output_datum(index_parameters,0,
     $              out_post_all[0][o_mean],'neutral density')
               hdf_data[i]=density           // NEUTRAL DENSITY
               ha_temp+=density*zn_volume(i)
@#if CMOD
               k=integral_region(zn_index(i,1),zn_index(i,2))
               integrals[k]+=density*zn_volume(i)
@#endif
            else
               hdf_data[i]=zero
            end if
         end do
         write(diskout,*) 'test i = ',j,
     $              ' total particles = ',ha_temp
@#if CMOD
         write(diskout,*) '   In core plasma:  ',integrals[1]
         write(diskout,*) '   In PFR:          ',integrals[2]
         write(diskout,*) '   Inner SOL:       ',integrals[3]
         write(diskout,*) '   Outer SOL:       ',integrals[4]  
@#endif
         call data_slice('sp'\/trim(sp_sy(pr_test(j)))\/'den.hdf',hdf_data,
     $        'sp'\/trim(sp_sy(pr_test(j)))\/' density','m**-3','E11.3',
     $        x,a,b,alen,blen)

         do i=1,zn_num
            if (zn_type(i) == zn_plasma) then
               index_parameters[tl_index_zone]=i
               pressure=extract_output_datum(index_parameters,0,
     $              out_post_all[0][o_mean],'neutral pressure')
               hdf_data[i]=pressure/const(1.3332,-1)  // NEUTRAL PRESSURE
            else
               hdf_data[i]=zero
            end if
         end do
         call data_slice('sp'\/trim(sp_sy(pr_test(j)))\/'prs.hdf',hdf_data,
     $        'sp'\/trim(sp_sy(pr_test(j)))\/' pressure','mTorr','E11.3',
     $        x,a,b,alen,blen)

      end do
@#endif
@#if 1
      do i=1,zn_num
         hdf_data[i]=zero
      end do

      do test=1,pr_test_num
         if ((sp_sy(pr_test(test)) == 'H')                  // NEUTRAL H-ALPHA
     $        || (sp_sy(pr_test(test)) == 'D')
     $        || (sp_sy(pr_test(test)) == 'T')) then
            ha_temp=zero
            do zone=1,zn_num
               if (zn_type(zone) == zn_plasma) then
                  index_parameters[tl_index_zone]=zone
                  ha_rate=extract_output_datum(index_parameters,0,
     $                 out_post_all[0][o_mean],
     $                 trim(sp_sy(pr_test(test)))\/'alpha emission rate')
     $                 /(const(1.8881944)*electron_charge)
                  hdf_data[zone]+=ha_rate
                  ha_temp+=ha_rate*zn_volume(zone)
               else
                  hdf_data[zone]=zero
               end if
            end do
            write(diskout,*) 'test = ',test,', ha = ',ha_temp 
         end if
      end do

      halpha_tot=zero
      do zone=1,zn_num
         halpha_tot+=hdf_data[zone]*zn_volume(zone)
      end do
      write(diskout,*) ' Halpha_tot = ',halpha_tot

      call data_slice('halpha.hdf',hdf_data,
     $     'H_alpha_rate','photons / s','E11.3',
     $     x,a,b,alen,blen)
@#endif
@#if 1

      do back=1,pr_background_num
         if (sp_sy(pr_background(back)) != 'e') then       // ION SOURCE RATE
            index_parameters[tl_index_back]=back
            ha_temp=zero
            do zone=1,zn_num
               if (zn_type(zone) == zn_plasma) then
                  index_parameters[tl_index_zone]=zone
                  ha_rate=extract_output_datum(index_parameters,0,
     $                 out_post_all[0][o_mean],'ion source rate')
     $                 /zn_volume(zone)
                  hdf_data[zone]=ha_rate
                  ha_temp+=ha_rate*zn_volume(zone)
               else
                  hdf_data[zone]=zero
               end if
            end do
            write(diskout,*) 'back = ',back,', source = ',ha_temp 
            call data_slice(trim(sp_sy(pr_background(back)))\/'ionize.hdf',
     $           hdf_data,trim(sp_sy(pr_background(back)))\/'_Ion_Source_rate',
     $           's**-1','E11.3',
     $           x,a,b,alen,blen)

         end if
      end do

@#endif
      var_free(hdf_data)

      return
      end

@ Divide up problem space into 4 regions of integration. Specifically
set up for Alcator C-Mod single null runs.

@<Functions...@>=
      function integral_region(j1,j2)
      implicit_none_f77
      implicit_none_f90
      integer integral_region
      integer j1,j2
      integer ixcut1,ixcut2,iycut,nx,ny
      data ixcut1,ixcut2,iycut,nx,ny/31,92,11,122,26/

      assert(1 <= j1 && j1 <= nx)
      assert(1 <= j2 && j2 <= ny)
      assert(j1 != ixcut1 && j1 != ixcut2)
      if (j2 <= iycut) then
         if (j1 < ixcut1 || j1 > ixcut2) then 
            integral_region=2
         else
            integral_region=1
         end if
      else
         if (j1 <= nx/2) then
            integral_region=3
         else
            integral_region=4
         end if
      end if

      return
      end     

@ Read in data from netcdf file \verb+output.nc+ 

@<Functions...@>=
      subroutine nc_read_output
      implicit_none_f77
      tl_common                  // Common
      ou_common
      rf_common
      so_common
      pr_common
      implicit_none_f90
      nc_decls
      st_decls
      tl_decls
      @<Memory allocation interface@>
      integer fileid             // Local
      ou_ncdecl
      character*FILELEN tempfile

      tempfile=filenames_array[outputfile]
      fileid=ncopen(tempfile,NC_NOWRITE,nc_stat)

      ou_ncread(fileid)

      call ncclose(fileid,nc_stat)

      return
      end

