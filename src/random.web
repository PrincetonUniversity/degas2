@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Define constants used in the basic random number generator.
The basic algorithm is
\begin{equation}\label{recursion}X_n=(X_{n-k}-X_{n-j})\bmod 1,\end{equation}
with $k$ and $j$ given by Knuth's Table 3.2.2--1 \cite{knuth2}.  In this
relation, replacing $j$ by $k-j$ is equivalent to running the recursion
backwards.  We make the choice $j\ge k/2$, since this results in longer
vectorizing loops.  We also choose $k=63$, since this is the largest $k$
such that |random_batch| vectorizes with short vector loops.

@m ran_k 63                     // Set $k$.
@m ran_j 31                     // Set $j$

@#if 2*ran_j < ran_k      // and ensure that $j\ge k/2$.
   @m ran_j $EVAL(ran_k-#!ran_j)
@#endif

@m ran_d 25               // $d = \lceil(2-\phi) k\rceil$ ($\phi=\frac12(\sqrt5+1)$) and $\gcd(k,d)=1$

$ASSERT(ran_k == RAN_K)   // Check that the header file set |RAN_K| correctly

@m ran_m0 $EVAL(2^24)                  // The limits on the seeds
@m ran_m1 $EVAL(2^23)

@* Functions to return random numbers.  We calculate the random numbers in
batches, placing the results into the array |ran_array|.  The routine to
return a single random number, |random|, can then merely return the next
array element.  It calls the routine to calculate the next batch if
necessary.  |ran_index| points to the next element of |ran_array| to be
used.  |ran_max| points to the first invalid element of |ran_array|.  Thus
the number of usable random numbers is |ran_max - ran_count|.  |ran_count|,
|ran_max|, and |ran_array| together describe the state of the random number
generator.  The header file packages these together into a single argument
|rn_args(x)|.

@<Functions...@>=
      function random(rn_dummy(x))
      implicit_none_f77
      implicit_none_f90
      real random               // Function
      rn_decl(x)                // Input/output
      external random_batch     // External

      if (rn_index(x) >= rn_max(x)) then
         call random_batch(rn_args(x))
      end if
      random=rn_array(x)[rn_index(x)]
      rn_index(x)=rn_index(x)+1
      return
      end

      subroutine random_array(arr,n,rn_dummy(x))
      implicit_none_f77
      implicit_none_f90
      integer n                 // Input
      real arr(0:n-1)           // Output
      rn_decl(x)             // Input/output
      integer i,k,j             // Local
      external random_batch     // External
      
      if (n<=0) return
      k=min(n,rn_max(x)-rn_index(x))
      do i=0,k-1
         arr[i]=rn_array(x)[i+rn_index(x)]
      end do
      rn_index(x)+=k
      do j=k,n-1,ran_k
         call random_batch(rn_args(x))
         do i=j,min(j+ran_k,n)-1
            arr[i]=rn_array(x)[i-j+rn_index(x)]
         end do
         rn_index(x)+=min(ran_k,n-j)
      end do
      return
      end
      
@ Check that there are at least |n| random numbers available.  After this
routine the next $n$ random numbers can be retrieved with |fast_random|.
Because of the size of the batches in which the random numbers are
generated, we require $n\le k$.

@<Functions...@>=
      subroutine random_check(n,rn_dummy(x))
      implicit_none_f77
      implicit_none_f90
      integer n                 // Input
      rn_decl(x)                // Input/output
      external random_batch     // External

      assert(0 <= n && n <= ran_k)
      if (n > rn_max(x)-rn_index(x)) call random_batch(rn_args(x))
      check(n <= rn_max(x)-rn_index(x))
      return
      end

@ If you've called |random_check(n,rn_args(x))|, then you can use this
routine to return the next $n$ random numbers.  Do loops calling
|fast_random| can be vectorized if |fast_random| is expanded inline.

@<Functions...@>=
      function fast_random(rn_dummy(x))
      implicit_none_f77
      implicit_none_f90
      real fast_random          // Function
      rn_decl(x)             // Input/output

      fast_random=rn_array(x)[rn_index(x)]
      rn_index(x)=rn_index(x)+1
      return
      end

@* Calculate the next batch.  The fills the next $k$ elements of
|rn_array(x)|.  |rn_array(x)| is dimensioned to hold $2k$ elements.  This
simplifies the coding of equation (\ref{recursion}).  It also allows
|random_batch| to be called before the previous batch is exhausted, which
in turn means that we can ensure that at least $n$ elements are available
at any time by calling |random_check(n,rn_args(x))| for $n\le k$.


@<Functions...@>=
      subroutine random_batch(rn_dummy(x))
      implicit_none_f77
      implicit_none_f90
      real ran_epsilon
      parameter (ran_epsilon=const(0.5)^48)
      rn_decl(x)             // Input/output
      integer i,k                 // Local
      real tmp

      check(rn_max(x) == ran_k || rn_max(x) == 2*ran_k) // We assume |rn_max(x)| takes on one of these values

/* First check we didn't take too many random numbers, e.g., by calling
|fast_random| too many times. */
      assert(rn_index(x) >= 0 && rn_index(x) <= rn_max(x))

      if (rn_index(x) < ran_k && rn_max(x) == 2*ran_k) return // Array already full

      if (rn_index(x) >= ran_k && rn_max(x) == 2*ran_k) then // Shift array down
         @<Shift |rn_array(x)| down |ran_k| elements@>
      end if

/* Fill second half.  The compiler codes this as two safe short vectors of
length |ran_j|, in order to avoid the recursion */
      do k=1-1,0,-1
      do i=ran_k,2*ran_k-1
         tmp=rn_array(x)[i-ran_k]-rn_array(x)[i-ran_j]
         if (tmp < zero) tmp=one+tmp
         rn_array(x)[i]=tmp+ran_epsilon
@#if 0
         tmp=rn_array(x)[i-ran_k]+rn_array(x)[i-ran_j]
         rn_array(x)[i]=tmp-int(tmp)
@#endif
      end do

      rn_max(x)=rn_max(x)+ran_k
      rn_count(x)=rn_count(x)+ran_k

      if (rn_index(x) >= ran_k) then // Shift array down
         @<Shift |rn_array(x)| down...@>
      end if
      if (k>0) then
         rn_index(x)+=ran_k
      end if
      end do

      check(rn_index(x) >= 0 && rn_index(x) < rn_max(x)) // Sanity check on |rn_index(x)|

      return
      end

@ |random_batch| needs to shift the data in the top half of |rn_array(x)| to
the bottom half.

@<Shift |rn_array(x)| down...@>=
         do i=0,ran_k-1         // a short vector move
            rn_array(x)[i]=rn_array(x)[i+ran_k]
         end do
         rn_index(x)=rn_index(x)-ran_k
         rn_max(x)=rn_max(x)-ran_k

@* Generating a sequence of random seeds.  

This initializes the random number array using the high 47 bits of
successive numbers from the |drand48| linear congruential converted to
56 bits.  Define
\begin{equation} \label{linear}
T(x)\equiv (a_1x+c_1) \bmod 2^{56},
\end{equation}
and
$$T^n(x)\equiv (a_nx+c_n) \bmod 2^{56}.$$
Then we have
$a_1=25214903917$, $c_1=11$;
$a_{63}=53631580600893541$,
$c_{63}=37732446681418217$;
$a_{-63}=39185939196621165$,
$c_{-63}=21393951150075595$.

The 56-bit numbers can be represented as an array of 4 14-bit integers
which allows the multiplications and additions necessary to perform
56-bit multiplies to be carried out on 32-bit machines.  (We don't use
15-bit integers since it is then necessary to do the multiplies more
carefully.)

To generate the seeds for subsequent random number thread we jump the
generator ahead multiples of 63 using $T^{63}$.

@ Here is |random_init|.  This iterates $T$ 63 times.  We make use of
the fact that $a_1$ and $c_1$ are (relatively) small to save on the
number of arithmetic operations here.  Finally the generator is warmed
up by coimputing 10 batches of numbers.

@<Functions...@>=
      subroutine random_init(seed,rn_dummy(x))
      implicit_none_f77
      implicit_none_f90
      integer base
      real ran_delta,ran_epsilon
      parameter (ran_delta=const(0.5)^14,ran_epsilon=const(0.5)^48,base=2^14)
      rn_seed_decl(seed)        // Input
      rn_decl(x)                // Output
      integer i,j,s[0:3],z[0:3]          // Local
      integer a0,a1,a2,c0,t
      data a0,a1,a2,c0/9837,15283,93,11/ // The base $2^{14}$ representation of $a_1$ and $c_1$

      do i=0,3
         assert(0<=seed[i] && seed[i]<base)
         s[i]=seed[i]
      end do

/* Set |rn_array(x)| from 47 most significant bits of |s|.  We place the
most significant (i.e., the most random) byte of |s| in the least
significant position in |rn_array(x)| where it can do the most good; and
so on with the other bytes; finally we place the five most significant
bits from the least significant byte in the five most significant bit
positions in |rn_array(x)|. */

      rn_array(x)[0]=(((s[3]*ran_delta+s[2])*ran_delta+
     $      s[1])*ran_delta+int(s[0]/512))*const(512.0)*ran_delta+ran_epsilon

      do j=1,ran_k-1
         t=c0+a0*s[0]
         z[0]=mod(t,base)
         t=int(t/base)+a0*s[1]+a1*s[0]
         z[1]=mod(t,base)
         t=int(t/base)+a0*s[2]+a1*s[1]+a2*s[0]
         z[2]=mod(t,base)
         t=int(t/base)+a0*s[3]+a1*s[2]+a2*s[1]
         z[3]=mod(t,base)

         do i=0,3
            s[i]=z[i]
         end do

         rn_array(x)[j]=(((s[3]*ran_delta+s[2])*ran_delta+
     $      s[1])*ran_delta+int(s[0]/512))*const(512.0)*ran_delta+ran_epsilon

      end do

      rn_max(x)=ran_k
      rn_index(x)=ran_k

      do i=1,10                 // Warm up the generator
         call random_batch(rn_args(x))
         rn_index(x)=rn_index(x)+ran_k
      end do

      rn_count(x) = 0           // Initialize count of random numbers produced
      rn_gauss_index(x) = 0     // Initialize the other generators
      rn_iso_index(x) = 0
      rn_cos_index(x) = 0

      end

@* Set the seed from an arbitrary string |string| is a string arbitrary
length.  |seed| is initialized to zero. Whitespace is ignored in the
string.  Initial digits 0--9 cause the operation |seed=10*seed+digit|.
Other characters cause the operation |seed=rotr(seed)+digit|, where
|rotr| is a circular right shift by one bit; this is the operation
carried out by the BSD sum utility.

@<Functions...@>=
      subroutine string_to_seed(string,seed)
      implicit_none_f77
      implicit_none_f90
      integer decbase,base
      parameter (decbase=10,base=2^14)
      character*(*) string
      rn_seed_decl(seed)
      logical digits
      integer t,r,i,k,a[0:3],c[0:3],ch
      data a/decbase,3*0/
      
      do i=0,3
         seed[i]=0
         c[i]=0
      end do
      
      digits=.true.
      do i=1,len(string)
         ch=ichar(string(i:i))
         if (digits && ch >= ichar('0') && ch <= ichar('9')) then
            c[0]=ch-ichar('0')
            call rand_axc(a,seed,c)
         else if (!(ch == ichar(' ') || ch == 9)) then // 9 is a tab
            digits=.false.
            seed[0]+=2*ch
            t=mod(seed[0],2)
            r=0
            do k=0,3
               seed[k]=int(seed[k]/2)
               if (k<3) then
                  seed[k]+=mod(seed[k+1],2)*(base/2)+r
               else
                  seed[k]+=t*(base/2)+r
               end if
               r=int(seed[k]/base)
               seed[k]=mod(seed[k],base)
            end do
//       else the character is whitespace and we skip it.
         end if
      end do
         
      return
      end

@* Convert a seed to its decimal equivalent.  |string| should be at
least 17 characters long; otherwise the high digits are lost.

@<Functions...@>=
      subroutine seed_to_string(seed,string)
      implicit_none_f77
      implicit_none_f90
      integer pow,decbase,base
      parameter (pow=4,decbase=10^pow,base=2^14)
      character*(*) string
      rn_seed_decl(seed)
      integer z[0:3],i,t,j,k
      character*20 b
      
      k=-1
      do i=0,3
         z[i]=seed[i]
         assert(0<=z[i] && z[i]<base)
         if (z[i]>0) k=i
      end do
      
      b=' '

 /* $2^{56} < 10^{20}$ */
      
      i=5
loop: continue
      i--
      t=0
      do j=k,0,-1
         z[j]=z[j]+t*base
         t=mod(z[j],decbase)
         z[j]=int(z[j]/decbase)
      end do
      if (z[max(0,k)]==0) k=k-1
      if (k>=0) then
         write(b(pow*i+1:pow*(i+1)),'(i4.4)') t
      else
         write(b(pow*i+1:pow*(i+1)),'(i4)') t
      end if
      if (k>=0) goto loop

      if (len(string)>len(b)) then
         string(:len(string)-len(b)) = ' '
         string(len(string)-len(b)+1:) = b
      else
         string = b(len(b)-len(string)+1:)
      end if
      
      return
      end

@* Choose random seed depending on current time and processor id.  This
initializes the seed with |yyyymmddhhmmsspp| where |yyyy| is the year,
etc. and |pp| is the procoss id (mod 100).

@<Functions...@>=
      subroutine set_random_seed(seed)
      implicit_none_f77
      implicit_none_f90
      rn_seed_decl(seed)        // Output
      integer temp[7]           // Local
      character*17 c
      external date_time,get_pid // External
      integer get_pid

      call date_time(temp)
      temp[7]=mod(get_pid(),1000)
      write(c,'(i4.4,5i2.2,i3.3)') temp
      call string_to_seed(c,seed)

      return
      end

@ |next_seed| steps the seed forward $n$ steps.  Thus, if $X_0 = x$, then
we have $X_n = y$.  $n$ is decomposed in binary and $x$ is stepped forward
by powers of 2.  We do this by composing equation (\ref{linear}) with
itself to give, e.g.,
$$
T^2(x) \equiv (a_2 x + c_2) \bmod 2^{56}.
$$
where $a_2=a_1^2 \bmod 2^{56}$ and $c_1= (a_1+1)c_1 \bmod 2^{56}$.  The
cpu time is proportional to $\log n$.

@<Functions...@>=
      subroutine next_seed(n,y)
      implicit_none_f77
      implicit_none_f90
      integer n          // Input
      rn_seed_decl(y)           // Input/Output
      integer af[0:3],cf[0:3],ab[0:3],cb[0:3],a[0:3],c[0:3],z[0:3],t[0:3],m,i
      data af/  101,14806, 6710,12194/ // $a_{63}$
      data cf/ 2537, 9167, 5981, 8579/ // $c_{63}$
      data ab/12653, 2052,13943, 8909/ // $a_{-63}$
      data cb/11979,10897, 6902, 4864/ // $c_{-63}$
      data z/4*0/

      if (n == 0) return

      if (n > 0) then
         m = n
         do i=0,3
            a[i]=af[i]
            c[i]=cf[i]
         end do
      else
         m = -n
         do i=0,3
            a[i]=ab[i]
            c[i]=cb[i]
         end do
      end if

loop: continue
      if (mod(m,2) > 0) then
         call rand_axc(a,y,c)
      end if
      m = int(m/2)
      if (m == 0) return
      rn_seed_copy(c,t)
      call rand_axc(a,c,t) /* $c'=(a+1)c$ */
      rn_seed_copy(a,t)
      call rand_axc(t,a,z) /* $a'=a^2$ */
      goto loop

      end


@ A utility routine.   Implement |x=a*x+c|.

@<Functions...@>=
      subroutine rand_axc(a,x,c)
      implicit_none_f77
      implicit_none_f90
      integer base
      parameter (base=2^14)
      integer a[0:3],c[0:3]     // Input
      integer x[0:3]            // Input/output
      integer z[0:3],i,j,t      // Local
      
      t=0
      do i=0,3
         t=c[i]+t
         do j=0,i
            t+=a[j]*x[i-j]
         end do
         z[i]=mod(t,base)
         t=int(t/base)
      end do
      
@#if SUN
/* The Sun f77 compiler has an optimization bug where it moves the assignment
|x=z| to the previous loop.  This conditional stops this from happening.
Note the |z[0]| should always be non-negative.

This bug in Sun f77 4.2 is fixed in f77 5.0
*/
      if (z[0] >= 0) then
@#endif
      do i=0,3
         x[i]=z[i]
      end do
@#if SUN
      end if
@#endif
      
      return
      end

