@* This program updates the background plasma parameters and DEGAS 2 sources
in iterations with a fluid plasma code. 

\ID{$Id$}

@m FILE 'updatebackground.web'

@I macros.hweb
@I readfilenames.hweb
@I problem.hweb
@I background.hweb
@I sources.hweb
@I zone.hweb
@I netcdf.hweb

@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ The main program.

@<Functions...@>=
      program updatebackground
      implicit_none_f77
      implicit_none_f90
      character*FILELEN datafilename

      call command_arg(1,datafilename)

      call ud_bk_main(datafilename)

      stop
      end

@ The main subroutine.

@<Functions...@>=
      subroutine ud_bk_main(datafilename)
      implicit_none_f77
      zn_common
      pr_common
      bk_common
      implicit_none_f90
      
      character*FILELEN datafilename                   // Input

      integer old_source_file, uedge                   // Local

      @<Memory allocation interface@>

      uedge = FALSE
      if (index(datafilename,'.u') > 0) then
         uedge = TRUE
      else
         assert('File name must end in .u' == ' ')
      end if

      call readfilenames

      call read_geometry
            
      call nc_read_elements
      call nc_read_species
      call nc_read_materials
      call nc_read_reactions
      call nc_read_pmi
      call nc_read_problem
      bk_num=pr_background_num
      var_alloc(background_n)
      var_alloc(background_v)
      var_alloc(background_temp)

      call nc_read_old_sources(old_source_file)

      if (uedge == TRUE) then
         if (old_source_file == TRUE) then
            call update_uedge_background(datafilename)         
         else
            call read_uedge_background(datafilename)
            call set_background_sources
            call init_wt_alias(uedge)
         end if
      endif

      call write_background
      call write_geometry     // Updated plasma sector properties

      return
      end

@ Calls routines to update the background plasma data. Also reads in
old source information to use in deciding how to update the sources
for the next run.

@<Functions...@>=
      subroutine update_uedge_background(datafilename)

      define_varp(old_current,FLOAT,source_seg_ind)
      define_varp(old_rel_wt,FLOAT,source_seg_ind)
      define_varp(old_tot_curr,FLOAT,source_grp_ind)

      implicit_none_f77
      pr_common                                  // Common
      so_common
      implicit_none_f90

      character*FILELEN datafilename             // Input

      integer nx,ny                              // Local; UEDGE file data:
      real rm[bk_mx,bk_my,0:4],zm[bk_mx,bk_my,0:4],
     $     ni[bk_mx,bk_my],vr[bk_mx,bk_my],vz[bk_mx,bk_my],vphi[bk_mx,bk_my],
     $     te[bk_mx,bk_my],ti[bk_mx,bk_my],
     $     ni1[bk_my],vr1[bk_my],vz1[bk_my],vphi1[bk_my],
     $     ti1[bk_my],te1[bk_my],flux1[bk_my],
     $     ni2[bk_my],vr2[bk_my],vz2[bk_my],vphi2[bk_my],
     $     ti2[bk_my],te2[bk_my],flux2[bk_my]
      integer grp,i_seg,jr,old_seg_tot,update
      real flux1_tot,flux2_tot

      declare_varp(old_current)
      declare_varp(old_rel_wt)
      declare_varp(old_tot_curr)

      @<Memory allocation interface@>

@#if 0
      call nc_read_old_sources
@#endif

      var_alloc(old_current)
      var_alloc(old_rel_wt)
      var_alloc(old_tot_curr)

/*
   Note: could update weights based only on last set of currents (using
   the old weights as well), but then we couldn't be sure of the total
   change since the original probability aliases were set. Hence,
   we really do want to dump out the source data for rereading here
   only when the aliases are updated.
*/
                              
      do grp=1,so_grps
         old_tot_curr[grp]=so_tot_curr(grp)
      end do
      do i_seg=1,so_seg_tot
         old_current[i_seg]=source_current[i_seg]
         old_rel_wt[i_seg]=source_segment_rel_wt[i_seg]
      end do
      old_seg_tot=so_seg_tot

      call init_uedge_background(datafilename,nx,ny,rm,zm,ni,vr,vz,vphi,
     $     ti,te,ni1,vr1,vz1,vphi1,ti1,te1,flux1,ni2,vr2,vz2,vphi2,
     $     ti2,te2,flux2,flux1_tot,flux2_tot)

      if (flux1_tot > zero && flux2_tot > zero) then
         grp=2
      else if (flux1_tot > zero || flux2_tot > zero) then
         grp=1
      else
         assert('Zero fluxes in UEDGE background' == ' ')
      end if

      update=TRUE    
      call set_uedge_plate_sources(nx,ny,rm,zm,
     $     vr1,vz1,vphi1,te1,ti1,flux1,
     $     vr2,vz2,vphi2,te2,ti2,flux2,flux1_tot,flux2_tot,update)

      if (pr_bkrc_num > 0) then
         do jr=1,pr_bkrc_num
            grp++
            so_seg_tot=so_base(grp)-1
            call set_background_rate(jr,grp,update)
c...Do asserts on results...
         end do
      end if

      assert(grp == so_grps)
      assert(so_seg_tot == old_seg_tot)

      call update_wt_alias(old_current,old_rel_wt,old_tot_curr)

      var_free(old_current)
      var_free(old_tot_curr)
      var_free(old_rel_wt)

      return
      end

c...Call set_prob_alias to check that we get same values?

@ Compare latest source currents with those last used to compute the
sampling arrays. If changes are not too large, account for them with a
weight factor. Otherwise, recompute the sampling arrays.

@<Functions...@>=
      subroutine update_wt_alias(old_current,old_rel_wt,old_tot_curr)

      implicit_none_f77
      so_common                                          // Common
      implicit_none_f90

      real old_current[*],old_rel_wt[*],old_tot_curr[*]  // Input

      integer i_seg,initialize,write_file                // Local
      so_decl(grp)
      
      write_file=FALSE
      do grp=1,so_grps

         so_wt_norm(grp)=zero
         initialize=FALSE
         do i_seg=so_base(grp),so_base(grp)+so_nseg(grp)-1
            if (old_current[i_seg] > zero) then
               source_segment_rel_wt[i_seg]=old_rel_wt[i_seg] 
     $              * source_current[i_seg]/ old_current[i_seg]
            else
               assert(source_current[i_seg] == zero)
            end if

            if (source_segment_rel_wt[i_seg] > so_rel_wt_max 
     $           || source_segment_rel_wt[i_seg] < so_rel_wt_min) then
               initialize=TRUE
               go to break
            end if
            so_wt_norm(grp)+=source_current[i_seg]
     $           / (so_tot_curr(grp)*source_segment_rel_wt[i_seg])
         end do
         if (so_wt_norm(grp) > so_wt_norm_max 
     $        || so_wt_norm(grp) < so_wt_norm_min)
     $        initialize=TRUE
break: continue

         if (initialize == TRUE) then
            write(stdout,*) ' Initializing sampling arrays for group ',grp
            write_file=TRUE
            do i_seg=so_base(grp),so_base(grp)+so_nseg(grp)-1
               source_segment_rel_wt[i_seg]=one
            end do
            call set_prob_alias(so_nseg(grp),
     $           source_current[so_base(grp)],
     $           source_segment_rel_wt[so_base(grp)],
     $           source_segment_ptr[so_base(grp)],
     $           source_segment_prob_alias[so_base(grp)],
     $           source_segment_ptr_alias[so_base(grp)],so_wt_norm(grp))

         end if
      end do

      if (write_file == TRUE) call write_old_sources

      return
      end

@ Read in old sources.

@<Functions...@>=
      subroutine nc_read_old_sources(old_source_file)
      implicit_none_f77
      so_common
      rf_common
      implicit_none_f90
      integer old_source_file      // Output
      integer fileid
      character *FILELEN tempfile  // Local
      nc_decls
      @<Memory allocation interface@>
      so_ncdecl

      tempfile=filenames_array[oldsourcefile]
      assert(tempfile != char_undef)
      call ncpopt(0)
      fileid=ncopen(tempfile,NC_NOWRITE,nc_stat)
      if (nc_stat != 0) then
         old_source_file=FALSE
         return
      else
         old_source_file=TRUE
      end if
      call ncpopt(NC_VERBOSE+NC_FATAL)
      
      so_ncread(fileid)
      call ncclose(fileid,nc_stat)

      return
      end





