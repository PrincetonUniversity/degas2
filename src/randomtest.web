@* A test program for the random number routines.

\ID{$Id$}

This random number generator is portable as long as no bits are lost in
the additions and subtractions in |random_batch|.  As a check, with the
seed is initialized to 31415926535897932, is advanced 23 steps to give
12169046133858735.  Then the zeroth and thousandth random numbers should
be $215019793392575/2^{48} \approx 0.7639037611986588$ and
$259243462334031/2^{48} \approx 0.9210177947737144$.

@m FILE 'randomtest.web'

@i macros.hweb

@I random.hweb

@ The main program.

@a
      program random_test
      implicit_none_f77
      implicit_none_f90
      rn_seed_decl(seed)        // Local
      integer i,j,k
      real x,start,end
      real xx[0:110000],yy[0:110000]
      character*17 dec
      rn_decl(tag)                     // Local for random number routines
      rn_decls
      sy_decls

@#if 0
      call test_prec
      stop
@#endif

      write(stdout,*) 'Test of random numbers'
      call string_to_seed('31415926535897932',seed) // $\lfloor 10^{16} \pi \rfloor$
      call seed_to_string(seed,dec)
      write(stdout,*) 'Seed (31415926535897932) = ',dec
      call next_seed(23,seed) // Should be 12169046133858735
      call seed_to_string(seed,dec)
      write(stdout,*) 'Seed (12169046133858735) = ',dec
      call random_init(seed,rn_args(tag))

/* Write out the zeroth random number */
      rn_next(x,tag)            // $215019793392575/2^{48} \approx 0.7639037611986588$
      write(stdout,*) 'Zeroth number (0.7639037611986588) = ',x

/* Here's how to use |fast_random| */
      do i=1,5*RAN_K,RAN_K
         call random_check(RAN_K,rn_args(tag)) // Check |RAN_K| numbers are available
         do j=i,i-1+RAN_K       // This loop can vectorize
            rn_fast_next(x,tag)
         end do
      end do

/* Here's how to use |random| */
      do i=5*RAN_K+1,880       // This loop won't vectorize
         rn_next(x,tag)
      end do
      

      call random_array(xx,1000-880,rn_args(tag))


/* Write out the thousandth random number */
@#if 0
      rn_next(x,tag)             // $259243462334031/2^{48} \approx 0.9210177947737144$
@#endif
      x=xx[1000-880-1]
      write(stdout,*) '1000th number (0.9210177947737144) = ',x
      
      call next_seed(-23,seed) // Backtrack seed
      call seed_to_string(seed,dec)
      write(stdout,*) 'Seed (31415926535897932) = ',dec
      
      call set_random_seed(seed)
      call seed_to_string(seed,dec)
      write(stdout,*) 'Random seed (based on time and pid) = ',dec

      /* Timing tests */
      start=cpu_time()
      do i=1,10000
         call next_seed(1,seed)
      end do
      end=cpu_time()
      write(stdout,*) 'Time of next_seed =',(end-start)/10000

      start=cpu_time()
      do i=1,10000
         call next_seed(312,seed)
      end do
      end=cpu_time()
      write(stdout,*) 'Time of 312 * next_seed =',(end-start)/10000

      start=cpu_time()
      do i=1,1000
         call random_init(seed,rn_args(tag))
      end do
      end=cpu_time()
      write(stdout,*) 'Time of random_init =',(end-start)/1000

      start=cpu_time()
      do k=1,100
         do i=1,1588*RAN_K,RAN_K
            call random_check(RAN_K,rn_args(tag))
            do j=i,i-1+RAN_K  
               rn_fast_next(xx[j],tag)
            end do
         end do
      end do
      end=cpu_time()
      write(stdout,*) 'Time of rn_fast_next =',(end-start)/(1588*RAN_K)/100

      start=cpu_time()
      do k=1,100
         do i=1,100000
            rn_next(xx[i],tag)
         end do
      end do
      end=cpu_time()
      write(stdout,*) 'Time of rn_next =',(end-start)/100000/100

      start=cpu_time()
      do k=1,100
         do i=1,100000
            xx[i]=random(rn_args(tag))
         end do
      end do
      end=cpu_time()
      write(stdout,*) 'Time of random =',(end-start)/100000/100

      start=cpu_time()
      do k=1,100
         call random_array(xx,100000,rn_args(tag))
      end do
      end=cpu_time()
      write(stdout,*) 'Time of random_array =',(end-start)/100000/100

      call new_test

@#if FORTRAN90
      call random_seed(size=k)
      write(stdout,*) 'seed size for random_number =',k
      start=cpu_time()
      do k=1,100
         call random_number(xx[0:99999])
      end do
      end=cpu_time()
      write(stdout,*) 'Time of random_number (fast) =',(end-start)/100000/100

      start=cpu_time()
      do k=1,100
         do i=1,100000
            call random_number(xx[i])
         end do
      end do
      end=cpu_time()
      write(stdout,*) 'Time of random_number =',(end-start)/100000/100
@#endif

@#if 0
      call test_string
@#endif
      stop
      end

      subroutine test_string
      implicit_none_f77
      implicit_none_f90
      logical read_string
      character*(80) line
      character*(17) res
      rn_seed_decl(seed)
      integer length

loop: continue
      if (read_string(stdin,line,length)) then
         call string_to_seed(line(1:length),seed)
         call seed_to_string(seed,res)
         write(stdout,*) line(1:length),' ',res
         goto loop
      end if
      return
      end

      subroutine new_test
      implicit_none_f77
      implicit_none_f90
      real x[0:1100-1]
      real ulp,start,end,tmp
      integer i
      sy_decls

      ulp=half^47
      x[0]=zero
      x[1]=ulp
      do i=2,99
         tmp=x[i-1]+x[i-2]
         x[i]=tmp-int(tmp)
      end do
      start=cpu_time()
      do i=1,10000
         call exercise1(x)
      end do
      end=cpu_time()
c     write(stdout,*) '1000th number = ', x[1100-1]
      write(stdout,*) 'Time of new test1 =',(end-start)*const(1.0,-4)*const(1.0,-3)
      start=cpu_time()
      do i=1,10000
         call exercise2(x)
      end do
      end=cpu_time()
c     write(stdout,*) '1000th number = ', x[1100-1]
      write(stdout,*) 'Time of new test2 =',(end-start)*const(1.0,-4)*const(1.0,-3)
      start=cpu_time()
      do i=1,10000
         call exercise3(x)
      end do
      end=cpu_time()
c     write(stdout,*) '1000th number = ', x[1100-1]
      write(stdout,*) 'Time of new test3 =',(end-start)*const(1.0,-4)*const(1.0,-3)
      start=cpu_time()
      do i=1,10000
         call exercise4(x)
      end do
      end=cpu_time()
c     write(stdout,*) '1000th number = ', x[1100-1]
      write(stdout,*) 'Time of new test4 =',(end-start)*const(1.0,-4)*const(1.0,-3)
      start=cpu_time()
      do i=1,10000
         call exercise5(x)
      end do
      end=cpu_time()
c     write(stdout,*) '1000th number = ', x[1100-1]
      write(stdout,*) 'Time of new test5 =',(end-start)*const(1.0,-4)*const(1.0,-3)
      start=cpu_time()
      do i=1,10000
         call exercise6(x)
      end do
      end=cpu_time()
c     write(stdout,*) '1000th number = ', x[1100-1]
      write(stdout,*) 'Time of new test6 =',(end-start)*const(1.0,-4)*const(1.0,-3)

      return
      end

      subroutine exercise1(x)
      implicit_none_f77
      implicit_none_f90
      real x[0:1100-1],tmp
      integer i
      do i=100,1100-1
         tmp=x[i-100]+x[i-63]
         x[i]=tmp-int(tmp)
      end do
      return
      end

      subroutine exercise2(x)
      implicit_none_f77
      implicit_none_f90
      real x[0:1100-1],tmp
      integer i
      do i=100,1100-1
         tmp=x[i-100]+x[i-63]
         if (tmp>=one) then
            x[i]=tmp-one
         else
            x[i]=tmp
         end if
      end do
      return
      end

      subroutine exercise3(x)
      implicit_none_f77
      implicit_none_f90
      real x[0:1100-1],tmp
      integer i
      do i=100,1100-1
         tmp=x[i-100]-x[i-63]
         if (tmp<zero) then
            x[i]=tmp+one
         else
            x[i]=tmp
         end if
      end do
      return
      end

      subroutine exercise4(x)
      implicit_none_f77
      implicit_none_f90
      real x[0:1100-1],tmp
      integer i
      do i=100,1100-1
         tmp=x[i-100]+x[i-37]
         x[i]=tmp-int(tmp)
      end do
      return
      end

      subroutine exercise5(x)
      implicit_none_f77
      implicit_none_f90
      real x[0:1100-1],tmp
      integer i
      do i=100,1100-1
         tmp=x[i-100]+x[i-37]
         if (tmp>=one) then
            x[i]=tmp-one
         else
            x[i]=tmp
         end if
      end do
      return
      end

      subroutine exercise6(x)
      implicit_none_f77
      implicit_none_f90
      real x[0:1100-1],tmp
      integer i
      do i=100,1100-1
         tmp=x[i-100]-x[i-37]
         if (tmp<zero) then
            x[i]=tmp+one
         else
            x[i]=tmp
         end if
      end do
      return
      end

      subroutine test_prec
      implicit_none_f77
      implicit_none_f90
      real x,y,z,ulp,eps
      integer i
      
      do i=46,54
         ulp=half**i
         eps=ulp*half
         x=half-eps
         y=half-ulp
         call dummy(x)
         y=y+x
         x=half+x
         call dummy(x)
         z=(x-eps)+(y-eps)
         z=(z-int(z))+eps
         z=z-1
         if (z != - 3*ulp + eps) then
            print *, 'eps', i
         end if
         y=x
         call dummy(x)
         z=(x-eps)+(y-eps)
         z=(z-int(z))+eps
         z=z-1
         if (z != - 2*ulp + eps) then
            print *, 'eps', i
         end if

         x=half-ulp
         y=half-2*ulp
         call dummy(x)
         call dummy(y)
         y=half+y
         x=half+x
         call dummy(x)
         z=x+y
         z=z-int(z)-1
         if (z != - 3*ulp) then
            print *, 'noeps1', i
         end if

         y=x
         call dummy(x)
         z=x+y
         z=z-int(z)-1
         if (z != - 2*ulp) then
            print *, 'noeps2', i
         end if

      end do
      return
      end
      
      subroutine dummy(x)
      implicit_none_f77
      implicit_none_f90
      real x
      return
      end

