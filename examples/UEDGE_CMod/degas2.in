# file names for degas2
#the name of this file is passed as argument to readfilenames
# syntax is : symbolic filename  [actual filename]
#the filenames can be in any order, comments and spaces will be ignored 
# (like this line). 

elementsfile  ../data/elements.nc 
backgroundfile bk_cmdetue.nc 
testfile  test.nc 
geometryfile ge_cmdetue.nc 
problemfile pr_cm960.nc 
reactionfile ../data/reactions.nc 
speciesfile ../data/species.nc 
aladinfile ../data/aladinput.nc
aladoutfile ../data/aladoutput.nc 
elements_infile ../data/elements.input 
problem_infile  ../examples/UEDGE_CMod/pr_cm960.input
reaction_infile ../data/reactions.input
species_infile ../data/species.input
materials_infile ../data/materials.input
materialsfile ../data/materials.nc
pmi_infile ../data/pmi.input
pmifile ../data/pmi.nc
cramdproblemfile cramdprob.nc
tallyfile tally_cmdetue.nc
outputfile degas2_cmdetue_out.nc
oldsourcefile os_cmdetue.nc
tally_infile ../examples/UEDGE_CMod/tally_cmdetue.input

